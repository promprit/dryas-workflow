{
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit", "hooks": [{"type": "command", "command": "\"${DRYAS_PY:-python3}\" -X utf8 \"${CLAUDE_PLUGIN_ROOT}/jev/chain.py\" pretool", "timeout": 20}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "\"${DRYAS_PY:-python3}\" -X utf8 \"${CLAUDE_PLUGIN_ROOT}/jev/chain.py\" prompt", "timeout": 15}]}
    ],
    "PostToolUse": [
      {"matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit", "hooks": [{"type": "command", "command": "\"${DRYAS_PY:-python3}\" -X utf8 \"${CLAUDE_PLUGIN_ROOT}/jev/chain.py\" post", "timeout": 10}]}
    ],
    "PostToolUseFailure": [
      {"matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit", "hooks": [{"type": "command", "command": "\"${DRYAS_PY:-python3}\" -X utf8 \"${CLAUDE_PLUGIN_ROOT}/jev/chain.py\" post", "timeout": 10}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "\"${DRYAS_PY:-python3}\" -X utf8 \"${CLAUDE_PLUGIN_ROOT}/jev/chain.py\" subagent-stop", "timeout": 5}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "\"${DRYAS_PY:-python3}\" -X utf8 \"${CLAUDE_PLUGIN_ROOT}/jev/chain.py\" stop", "timeout": 5}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "\"${DRYAS_PY:-python3}\" -X utf8 \"${CLAUDE_PLUGIN_ROOT}/jev/chain.py\" session-end", "timeout": 5}]}
    ],
    "SessionStart": [
      {"matcher": "startup|resume|clear|compact", "hooks": [{"type": "command", "command": "\"${DRYAS_PY:-python3}\" -X utf8 \"${CLAUDE_PLUGIN_ROOT}/jev/rules_inject.py\"", "timeout": 5}, {"type": "command", "command": "\"${DRYAS_PY:-python3}\" -X utf8 \"${CLAUDE_PLUGIN_ROOT}/jev/chain.py\" session-start", "timeout": 5}]},
      {"matcher": "compact", "hooks": [{"type": "command", "command": "\"${DRYAS_PY:-python3}\" -X utf8 \"${CLAUDE_PLUGIN_ROOT}/jev/compact_restore.py\"", "timeout": 5}]},
      {"matcher": "clear", "hooks": [{"type": "command", "command": "\"${DRYAS_PY:-python3}\" -X utf8 \"${CLAUDE_PLUGIN_ROOT}/jev/handoff_restore.py\"", "timeout": 5}]}
    ],
    "PreCompact": [
      {"hooks": [{"type": "command", "command": "\"${DRYAS_PY:-python3}\" -X utf8 \"${CLAUDE_PLUGIN_ROOT}/jev/compact_keep.py\"", "timeout": 30}]},
      {"hooks": [{"type": "command", "command": "\"${DRYAS_PY:-python3}\" -X utf8 \"${CLAUDE_PLUGIN_ROOT}/jev/chain.py\" precompact", "timeout": 5}]}
    ]
  }
}
