{
  "description": "Dryas Workflow: rules at session start, Jev route hint, scope lock and Jev gate.",
  "hooks": {
    "SessionStart": [
      {"matcher": "startup|resume|clear|compact", "hooks": [{"type": "command", "command": "\"${DRYAS_PY:-python3}\" -X utf8 \"${PLUGIN_ROOT}/jev/rules_inject.py\" --harness codex", "commandWindows": "python -X utf8 \"%PLUGIN_ROOT%\\jev\\rules_inject.py\" --harness codex", "timeout": 5}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "\"${DRYAS_PY:-python3}\" -X utf8 \"${PLUGIN_ROOT}/jev/chain.py\" prompt --harness codex", "commandWindows": "python -X utf8 \"%PLUGIN_ROOT%\\jev\\chain.py\" prompt --harness codex", "timeout": 15}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash|apply_patch|Edit|Write", "hooks": [{"type": "command", "command": "\"${DRYAS_PY:-python3}\" -X utf8 \"${PLUGIN_ROOT}/jev/chain.py\" pretool --harness codex", "commandWindows": "python -X utf8 \"%PLUGIN_ROOT%\\jev\\chain.py\" pretool --harness codex", "timeout": 20}]}
    ]
  }
}
